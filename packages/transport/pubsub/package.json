{
	"name": "@peerbit/pubsub",
	"version": "5.4.4",
	"description": "Direct streaming for libp2p",
	"type": "module",
	"types": "./dist/src/index.d.ts",
	"typesVersions": {
		"*": {
			"*": [
				"*",
				"dist/*",
				"dist/src/*",
				"dist/src/*/index"
			],
			"src/*": [
				"*",
				"dist/*",
				"dist/src/*",
				"dist/src/*/index"
			]
		}
	},
	"files": [
		"src",
		"dist",
		"!dist/benchmark",
		"!dist/e2e",
		"!dist/test",
		"!**/*.tsbuildinfo"
	],
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"import": "./dist/src/index.js"
		}
	},
	"eslintConfig": {
		"extends": "peerbit",
		"parserOptions": {
			"project": true,
			"sourceType": "module"
		},
		"ignorePatterns": [
			"!.aegir.js",
			"test/ts-use",
			"*.d.ts"
		]
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"bench": "TS_NODE_PROJECT=../../../tsconfig.json node --loader ts-node/esm ./benchmark/index.ts",
		"clean": "aegir clean",
		"build": "aegir build --no-bundle",
		"test": "aegir test --target node",
		"lint": "aegir lint",
		"test:cov": "aegir test -t node --cov"
	},
	"engines": {
		"node": ">=16.15.1"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dao-xyz/peerbit.git",
		"directory": "packages/transport/pubsub"
	},
	"keywords": [
		"peerbit"
	],
	"author": "Peerbit contributors",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/dao-xyz/peerbit/issues"
	},
	"homepage": "https://github.com/dao-xyz/peerbit#readme",
	"devDependencies": {
		"@peerbit/libp2p-test-utils": "workspace:*"
	},
	"dependencies": {
		"@dao-xyz/borsh": "^6.0.0",
		"@libp2p/circuit-relay-v2": "^4.2.11",
		"@libp2p/crypto": "^5.1.22",
		"@libp2p/identify": "^4.1.12",
		"@libp2p/interface": "^3.2.5",
		"@libp2p/tcp": "^11.0.26",
		"@libp2p/websockets": "^10.1.19",
		"@multiformats/multiaddr": "^13.0.3",
		"@peerbit/any-store-interface": "workspace:*",
		"@peerbit/crypto": "workspace:*",
		"@peerbit/logger": "workspace:*",
		"@peerbit/pubsub-interface": "workspace:*",
		"@peerbit/stream": "workspace:*",
		"@peerbit/stream-interface": "workspace:*",
		"@peerbit/time": "workspace:*",
		"any-signal": "^4.1.0",
		"it-length-prefixed": "^11.0.1",
		"it-pipe": "^3.0.1",
		"it-pushable": "^3.1.4",
		"p-defer": "^4.0.0",
		"uint8arraylist": "^3.0.2",
		"uint8arrays": "^5.1.0"
	}
}
